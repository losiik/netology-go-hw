# Скопируйте в .env и поменяйте секреты: cp .env.example .env

# PostgreSQL (пароль без символов @ : / ? # — он подставляется в DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cashapp

# Порты на хосте
GATEWAY_PORT=8080
DB_PORT=5434

# JWT: секрет не короче 32 символов, общий для auth и gateway
JWT_SECRET=change-me-please-use-a-long-random-string-0123456789
JWT_TTL=24h

# Таймаут на один HTTP-запрос к gateway (Go duration: 500ms, 10s, 1m)
REQUEST_TIMEOUT=10s
